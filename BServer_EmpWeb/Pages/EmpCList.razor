@inherits EmpCListBase

<div class="card m-3" style="min-width:18rem; max-width:30.5%;">

    <div class="card-header">
        <h3>
            <input type="checkbox" @onchange="EH_ChangeCheckBox"/>
            @mEmp.FirstName @mEmp.LastName
        </h3>
    </div>

    <img class="card-img-top imageThumbail" src="@mEmp.PhotoPath" />

    @if (IsVisibleFooter)
    {
        <div class="card-footer text-center">
            <a href="@($"empdetails/{mEmp.EmpID}") " class="btn btn-primary m-1">View</a>
            <a href="@($"editemp/{mEmp.EmpID}")" class="btn btn-primary m-1">Edit</a>
            <button type="button" class="btn btn-danger m-1" @onclick="EH_Deleting">
                Delete
            </button>
        </div>
    }

</div>

<ReC_Confirm OnConfirmChanges="EH_ConfirmDelete_Click" 
             ConfirmMessage=@($"Are you sure you want to delete \"{mEmp.FirstName}\" ?") 
             @ref="DeleteConfirmation">
</ReC_Confirm>
@page "/editemp_10/{empid}"
@page "/editemp_10"
@inherits EditEmpBase

@* Using the specific model for EditEmp that contains ConfirmEmail property *@
<EditForm Model="@msEditEmp" OnValidSubmit="HandleValidSubmit">

    @* Adding the validation for a Complex Type *@
    <ObjectGraphDataAnnotationsValidator />

    <h3 style="font-family:'Book Antiqua'">
        @PageHeaderText
    </h3>
    <hr />

    <ValidationSummary />

    <div class="form-group row">
        <label for="FName" class="col-sm-2 col-form-label">
            First Name
        </label>
        <div class="col-sm-10">
            <InputText id="FName" class="form-control" placeholder="First Name"
                       @bind-Value="msEditEmp.FirstName" />
            <ValidationMessage For="@(() => msEditEmp.FirstName)" />
        </div>
    </div>

    <div class="form-group row">
        <label for="LName" class="col-sm-2 col-form-label">
            Last Name
        </label>
        <div class="col-sm-10">
            <InputText id="LName" class="form-control" placeholder="Last Name"
                       @bind-Value="msEditEmp.LastName" />
            <ValidationMessage For="@(() => msEditEmp.LastName)" />
        </div>
    </div>

    <div class="form-group row">
        <label for="EmpEmail" class="col-sm-2 col-form-label">
            Email
        </label>
        <div class="col-sm-10">
            <InputText id="EmpEmail" class="form-control" placeholder="Email"
                       @bind-Value="msEditEmp.Email" />
            <ValidationMessage For="@(() => msEditEmp.Email)" />
        </div>
    </div>

    @* Adding the ConfirmEmail property *@
    <div class="form-group row">
        <label for="ConfirmEmail" class="col-sm-2 col-form-label">
            Confirm Email
        </label>
        <div class="col-sm-10">
            <InputText id="ConfirmEmail" class="form-control" placeholder="Confirm Email"
                       @bind-Value="msEditEmp.ConfirmEmail" />
            <ValidationMessage For="@(() => msEditEmp.ConfirmEmail)" />
        </div>
    </div>

    @* Using Razor Class Library project *@
    <div class="form-group row">
        <label for="EmpDep" class="col-sm-2 col-form-label">
            Department
        </label>
        <div class="col-sm-10">
            <RCL_Cust_InputSelect id="EmpDep" class="form-control" @bind-Value="msEditEmp.DeptID">
                @foreach (var d in L_mDep)
                {
                    <option value="@d.DepID">@d.DepName</option>
                }
            </RCL_Cust_InputSelect>
        </div>
    </div>

    @* Using Enum *@
    <div class="form-group row">
        <label for="EmpGdr" class="col-sm-2 col-form-label">
            Gender
        </label>
        <div class="col-sm-10">
            <InputSelect id="EmpGdr" class="form-control" @bind-Value="msEditEmp.GenderSex">
                @foreach (var gdr in Enum.GetValues(typeof(EGender)))
                {
                    <option value="@gdr">@gdr</option>
                }
            </InputSelect>
        </div>
    </div>

    @* Adding DatePicker *@
    <div class="form-group row">
        <label for="EmpDOB" class="col-sm-2 col-form-label">
            Date Of Birth
        </label>
        <div class="col-sm-10">
            <InputDate id="EmpDOB" class="form-control" @bind-Value="msEditEmp.DOBirth">
            </InputDate>
        </div>
    </div>

    @* Adding Complex Type DepName *@
    <!--<div class="form-group row">
        <label for="DName" class="col-sm-2 col-form-label">
            Department Name
        </label>
        <div class="col-sm-10">
            <InputText id="DName" class="form-control" @bind-Value="msEditEmp.Dep_Nav.DepName">
            </InputText>
            <ValidationMessage For="@(() => msEditEmp.Dep_Nav.DepName)" />
        </div>
    </div>-->

    <button class="btn btn-primary" type="submit">Submit</button>

</EditForm>


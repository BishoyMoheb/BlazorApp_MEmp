@page "/emplist_0"
@inherits EmpListBase

<h3 style="font-family:'Book Antiqua'">Employee List</h3>

@if (E_MEmpI == null)
{
    <div class="spinner"></div>
}
else
{
    <div class="card-deck" style="font-family:'Book Antiqua'">

        @foreach (var E_mEmp in E_MEmpI)
        {
            <div class="card m-3" style="min-width:18rem; max-width:30.5%;">

                <div class="card-header">
                    <h3>@E_mEmp.FirstName @E_mEmp.LastName</h3>
                </div>

                <img class="card-img-top imageThumbail" src="@E_mEmp.PhotoPath"/>

                <div class="card-footer text-center">
                    <a href="@($"empdetails/{E_mEmp.EmpID}") " class="btn btn-primary m-1">View</a>
                    <a href="#" class="btn btn-primary m-1">Edit</a>
                    <a href="#" class="btn btn-danger m-1">Delete</a>
                </div>

            </div>
        }

    </div>
}
